	partition f_calidad_datos = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(RutaDatos & "f_calidad_datos.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"problema", type text}, {"alcance", type text}, {"tratamiento", type text}}, "en-US")
				in
				    Typed

