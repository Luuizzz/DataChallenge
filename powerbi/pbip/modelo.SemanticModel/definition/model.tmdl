ref table f_modelo_ingreso_deciles
ref table f_modelos_metricas
ref table f_n_servicios
ref table f_pronostico_3h
ref table f_simulacion_escenarios
ref table f_simulacion_sensibilidad
ref table _Medidas
ref table f_interconsultas_ajustado
ref table f_modelo_ventanas
ref table f_decision
ref table f_validacion_2026

ref cultureInfo en-US

